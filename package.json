{
	"name": "skool-admin",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "26.x",
		"npm": "11.x"
	},
	"packageManager": "npm@11.20.0",
	"volta": {
		"node": "26.13.0",
		"npm": "11.20.0"
	},
	"scripts": {
		"dev": "next dev",
		"dev:all": "npm run services:up && prisma migrate deploy && prisma generate && next dev",
		"build": "prisma generate && next build",
		"start": "next start",
		"lint": "eslint . --max-warnings=0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "prisma generate && next typegen && tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate dev",
		"db:deploy": "prisma migrate deploy",
		"db:seed": "prisma db seed",
		"db:studio": "prisma studio",
		"services:up": "docker compose up -d --wait",
		"services:down": "docker compose down",
		"prepare": "husky",
		"postinstall": "prisma generate"
	},
	"dependencies": {
		"@hookform/resolvers": "6.0.2",
		"@next-auth/prisma-adapter": "1.0.7",
		"@prisma/adapter-pg": "7.10.1",
		"@prisma/client": "7.10.1",
		"@radix-ui/react-slot": "1.5.0",
		"@tanstack/react-table": "9.3.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"dotenv": "18.0.9",
		"lucide-react": "1.63.0",
		"next": "16.4.6",
		"next-auth": "4.24.15",
		"pg": "8.23.1",
		"pino": "10.4.0",
		"pino-pretty": "13.2.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"react-hook-form": "7.91.0",
		"recharts": "3.10.1",
		"server-only": "0.0.1",
		"tailwind-merge": "3.7.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/node": "26.6.6",
		"@types/pg": "8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/coverage-v8": "5.0.5",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.6",
		"eslint-config-prettier": "10.1.8",
		"husky": "9.1.7",
		"jsdom": "30.1.3",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"prettier-plugin-tailwindcss": "0.8.1",
		"prisma": "7.10.1",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,tsx}": [
			"eslint --fix --max-warnings=0",
			"prettier --write"
		],
		"*.{json,jsonc,css,md,yml,yaml}": "prettier --write",
		"*.prisma": "prisma format"
	},
	"allowScripts": {
		"@prisma/engines@7.10.1": true,
		"prisma@7.10.1": true,
		"esbuild@0.28.2": true,
		"unrs-resolver@1.12.2": true,
		"fsevents@2.3.3": true
	}
}
