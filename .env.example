NODE_ENV=development
# Direct (non-pooled) connection: migrations, Prisma Studio, seed.
DATABASE_URL=postgresql://skool:local-development-only@localhost:5432/skool_admin?schema=public
# Optional pooled connection (e.g. PgBouncer) used by the app at runtime.
# Leave empty to use DATABASE_URL.
DATABASE_URL_POOLED=
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
# Google OAuth "Web application" client from a Cloud project owned by the Skool
# Workspace organisation (consent screen user type: Internal). Authorised
# redirect URI: <NEXTAUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Workspace domain whose members may sign in (hostname, no "@").
AUTH_ALLOWED_DOMAIN=skool.org.hu
# Google Doc ID of the closing-report template (from its URL,
# docs.google.com/document/d/<ID>/edit). Share it with the domain as Viewer.
REPORT_TEMPLATE_DOC_ID=16n_EFvra8kRgoxQxBBVwpm-SBqOkCl7umLYnXeYycXM
LOG_LEVEL=info
