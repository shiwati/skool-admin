generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]

  updatedApplicants   Applicant[]           @relation("ApplicantUpdatedBy")
  updatedApplications Application[]         @relation("ApplicationUpdatedBy")
  historyEntries      History[]
  deletedApplicants   Applicant[]           @relation("ApplicantDeletedBy")
  duplicateDismissals DuplicateDismissal[]
  updatedReports      EventReport[]
  reportDocuments     EventReportDocument[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain ──────────────────────────────────────────────────────────────────

/// Jelentkező
model Applicant {
  id                String               @id @default(cuid())
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  updatedById       String?              @map("updated_by")
  updatedBy         User?                @relation("ApplicantUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  firstName         String               @map("first_name")
  lastName          String               @map("last_name")
  birthYear         Int?                 @map("birth_year")
  schoolName        String?              @map("school_name")
  hometown          String?
  phoneNumber       String?              @map("phone_number")
  email             String?
  parentFirstName   String?              @map("parent_first_name")
  parentLastName    String?              @map("parent_last_name")
  parentMothersName String?              @map("parent_mothers_name")
  parentAddress     String?              @map("parent_address")
  parentEmail       String?              @map("parent_email")
  parentPhone       String?              @map("parent_phone")
  newsletter        Boolean              @default(false)
  /// GDPR törlés (anonimizálás) ideje; null = aktív jelentkező
  deletedAt         DateTime?            @map("deleted_at")
  deletedById       String?              @map("deleted_by")
  deletedBy         User?                @relation("ApplicantDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  /// Normalizált vezetéknév + utónév + e-mail; azonos kulcs = lehetséges duplikátum.
  duplicateKey      String?              @map("duplicate_key")
  /// Igaz, ha van másik jelentkező ugyanazzal a kulccsal; az admin merge-öli.
  duplicateFlag     Boolean              @default(false) @map("duplicate_flag")
  /// Keresés: kisbetűs, ékezet nélküli név + e-mail (trigger tölti, lásd docs/data-and-db.md).
  searchText        String?              @map("search_text")
  /// Keresés: kisbetűs, ékezet nélküli település (trigger tölti).
  hometownSearch    String?              @map("hometown_search")
  applications      Application[]
  dismissalsAsA     DuplicateDismissal[] @relation("DismissalApplicantA")
  dismissalsAsB     DuplicateDismissal[] @relation("DismissalApplicantB")

  @@index([email])
  @@index([deletedAt])
  @@index([duplicateKey])
  @@map("applicant")
}

/// "Nem duplikáció" admin döntés egy jelentkezőpárra. Párra szól, így egy
/// később érkező, azonos kulcsú jelentkező új párként újra megjelenik.
/// A pár rendezett: applicantAId < applicantBId.
model DuplicateDismissal {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now()) @map("created_at")
  createdById  String?   @map("created_by")
  createdBy    User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  applicantAId String    @map("applicant_a_id")
  applicantA   Applicant @relation("DismissalApplicantA", fields: [applicantAId], references: [id], onDelete: Cascade)
  applicantBId String    @map("applicant_b_id")
  applicantB   Applicant @relation("DismissalApplicantB", fields: [applicantBId], references: [id], onDelete: Cascade)

  @@unique([applicantAId, applicantBId])
  @@index([applicantBId])
  @@map("duplicate_dismissal")
}

/// Jelentkezés (Event × Applicant)
model Application {
  id                         String            @id @default(cuid())
  receivedAt                 DateTime          @default(now()) @map("received_at")
  createdAt                  DateTime          @default(now()) @map("created_at")
  updatedAt                  DateTime          @updatedAt @map("updated_at")
  updatedById                String?           @map("updated_by")
  updatedBy                  User?             @relation("ApplicationUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  eventId                    String            @map("event_id")
  event                      Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  applicantId                String            @map("applicant_id")
  applicant                  Applicant         @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  foodPreference             String?           @map("food_preference")
  heardFromWhere             String?           @map("heard_from_where")
  heardFromWhom              String?           @map("heard_from_whom")
  solvedProblem              String?           @map("solved_problem")
  pastExpInProg              String?           @map("past_exp_in_prog")
  pastParticipationOther     String?           @map("past_participation_other")
  pastParticipationSkool     Boolean           @default(false) @map("past_participation_skool")
  pastParticipationSkoolDesc String?           @map("past_participation_skool_desc")
  comment                    String?
  companyAwareness           Boolean           @default(false) @map("company_awareness")
  status                     ApplicationStatus @default(APPLIED)
  /// Forrás-sor azonosítója (sheet import): újraszinkronnál nem jön létre kétszer.
  sourceKey                  String?           @map("source_key")

  @@unique([eventId, sourceKey])
  @@index([applicantId])
  @@index([eventId, applicantId])
  @@index([eventId, status])
  @@map("application")
}

/// Jelentkezés állapota
enum ApplicationStatus {
  APPLIED    @map("applied") /// jelentkezett
  ACCEPTED   @map("accepted") /// elfogadva
  REJECTED   @map("rejected") /// elutasítva
  ATTENDED   @map("attended") /// részt vett
  WAITLISTED @map("waitlisted") /// várólistás

  @@map("application_status")
}

/// Program / esemény
model Event {
  id                              String                @id @default(cuid())
  createdAt                       DateTime              @default(now()) @map("created_at")
  updatedAt                       DateTime              @updatedAt @map("updated_at")
  name                            String
  from                            DateTime
  to                              DateTime
  companyName                     String?               @map("company_name")
  location                        String?
  description                     String?               @map("desc")
  /// Jelentkező űrlap válasz-sheetje
  applicationSheetUrl             String?               @map("application_sheet_url")
  /// Résztvevői visszajelző űrlap válasz-sheetje
  participantFeedbackSheetUrl     String?               @map("participant_feedback_sheet_url")
  /// Mentori visszajelző űrlap válasz-sheetje
  mentorFeedbackSheetUrl          String?               @map("mentor_feedback_sheet_url")
  /// Mező → pontos sheet-fejléc a jelentkezők sheetjéhez; null = alapértelmezett (kulcsszavas) felismerés.
  applicationSheetMapping         Json?                 @map("application_sheet_mapping")
  /// { columns: kérdéskulcs → fejléc, custom: egyéni kérdések }; null = alapértelmezett.
  participantFeedbackSheetMapping Json?                 @map("participant_feedback_sheet_mapping")
  /// Mint a résztvevőinél, a mentori visszajelző sheethez.
  mentorFeedbackSheetMapping      Json?                 @map("mentor_feedback_sheet_mapping")
  ageRange                        String?               @map("age_range")
  instructor                      String?
  /// Keresés: kisbetűs, ékezet nélküli mezők (trigger tölti, lásd docs/data-and-db.md).
  nameSearch                      String?               @map("name_search")
  locationSearch                  String?               @map("location_search")
  companySearch                   String?               @map("company_search")
  instructorSearch                String?               @map("instructor_search")
  mentors                         String[]
  tags                            String[]              @default([])
  capacity                        Int                   @default(0)
  applications                    Application[]
  feedbacks                       Feedback[]
  report                          EventReport?
  reportDocuments                 EventReportDocument[]

  @@map("event")
}

/// Mezőszintű változásnapló
model History {
  id          String   @id @default(cuid())
  tableName   String   @map("table_name")
  fieldName   String   @map("field_name")
  oldValue    String?  @map("old_value")
  newValue    String?  @map("new_value")
  recordId    String   @map("record_id")
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([tableName, recordId])
  @@map("history")
}

enum FeedbackRole {
  PARTICIPANT @map("participant") /// résztvevő (diák)
  MENTOR      @map("mentor") /// mentor

  @@map("feedback_role")
}

/// Anonim visszajelző űrlap-válasz (résztvevői vagy mentori Google Form sheetből).
model Feedback {
  id           String       @id @default(cuid())
  createdAt    DateTime     @default(now()) @map("created_at")
  eventId      String       @map("event_id")
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role         FeedbackRole
  /// Az űrlap időbélyege (a sheet időzónájában értelmezve).
  submittedAt  DateTime?    @map("submitted_at")
  /// Stabil kérdéskulcs → válasz (lásd `src/lib/feedback/questions.ts`).
  answers      Json
  /// Összértékelés 1–5: résztvevőnél a mentor- és oktatóértékelés átlaga, mentornál a saját összértékelése.
  overallScore Float?       @map("overall_score")
  /// Ajánlaná: "yes" | "maybe" | "no"; null, ha az űrlapban nincs ilyen kérdés.
  recommend    String?
  /// Kisbetűs, ékezet nélküli, összefűzött szöveges válaszok a kereséshez (a triggere hajtogatja).
  searchText   String       @default("") @map("search_text")
  /// Forrás-sor azonosítója: újraszinkronnál nem jön létre kétszer.
  sourceKey    String       @map("source_key")

  @@unique([eventId, role, sourceKey])
  @@index([eventId, role])
  @@index([submittedAt])
  @@map("feedback")
}

/// Záró riport szerkesztett adatai (eseményenként egy). A tartalom sémája: `src/lib/reports/content.ts`.
model EventReport {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by")
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  eventId     String   @unique @map("event_id")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  content     Json

  @@map("event_report")
}

/// A riportból generált Google Doc (minden generálás új dokumentum).
model EventReportDocument {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now()) @map("created_at")
  createdById String?  @map("created_by")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  eventId     String   @map("event_id")
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  docId       String   @map("doc_id")
  docUrl      String   @map("doc_url")
  title       String

  @@index([eventId, createdAt])
  @@map("event_report_document")
}
